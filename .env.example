# =========================================================================
# Copiar a .env y completar. NUNCA versionar el .env real.
# Generar secretos con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generar la clave AES con: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# =========================================================================

ENTORNO=development           # development | production
DEBUG=true

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://prediccion:prediccion@localhost:5432/prediccion

# --- Criptografia ---
# Firma de cookies de sesion (>=32 caracteres)
SECRET_KEY=cambiar-por-un-valor-aleatorio-de-al-menos-32-caracteres
# AES-256-GCM para cifrado a nivel de columna: 32 bytes en base64 urlsafe
CLAVE_CIFRADO_DATOS=cambiar-por-32-bytes-en-base64-urlsafe=
# HMAC para el indice ciego que permite buscar por email sin descifrar
CLAVE_INDICE_CIEGO=cambiar-por-otro-valor-aleatorio-distinto-al-anterior

# --- Sesiones ---
SESION_DURACION_HORAS=12
COOKIE_SEGURA=false           # true obligatorio en produccion (HTTPS)

# --- CORS: dominios exactos del frontend, separados por coma. Nunca "*" ---
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# --- APIs externas ---
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_RPM=10          # requests por minuto permitidos por el plan gratis
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_CUOTA_DIARIA=100

# --- Scheduler ---
SCHEDULER_ACTIVO=true
SINCRONIZACION_CRON_HORAS=3,15    # horas (UTC) en las que corre la sincronizacion
REENTRENAMIENTO_DIA_SEMANA=mon    # dia de reentrenamiento semanal
REENTRENAMIENTO_HORA=4

# --- Admin bootstrap (solo primer arranque; borrar del .env despues) ---
ADMIN_EMAIL_INICIAL=
ADMIN_PASSWORD_INICIAL=

# Puerto del front en el host; cambialo si el 5173 esta ocupado
PUERTO_FRONTEND=5173

# --- Ingreso con Google (opcional) ---
# Se sacan de Google Cloud Console > APIs y servicios > Credenciales >
# ID de cliente de OAuth > Aplicacion web. Es gratis.
# En "URI de redireccionamiento autorizados" cargar exactamente GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
URL_FRONTEND=http://localhost:5173

# --- Analisis narrativo con Claude (opcional, de pago) ---
# Sin clave el endpoint responde 404 y la app funciona igual.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5
ANTHROPIC_ESFUERZO=high
ANTHROPIC_BUSQUEDA_WEB=true
